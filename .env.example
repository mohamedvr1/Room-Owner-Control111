# Copy the variables you need into Replit Secrets or a local .env file.
# Never commit real values to the repository or include them in exports.

# Required by the API server
PORT=5000
SESSION_SECRET=replace-with-a-long-random-value

# Optional GhostRoom owner and room-master access
OWNER_SECRET=replace-with-owner-secret
SUPER_SECRET=replace-with-room-master-secret

# Optional border/payment configuration
VODAFONE_CASH_NUMBER=replace-with-public-payment-number
BORDER_CODE_CRIMSON=replace-with-private-code
BORDER_CODE_SAPPHIRE=replace-with-private-code
BORDER_CODE_EMERALD=replace-with-private-code
BORDER_CODE_VIOLET=replace-with-private-code
BORDER_CODE_ORANGE=replace-with-private-code
PAYMOB_API_KEY=replace-with-paymob-api-key
PAYMOB_INTEGRATION_ID=0
PAYMOB_IFRAME_ID=0
PAYMOB_HMAC_SECRET=replace-with-paymob-hmac-secret
APP_URL=https://your-app.example